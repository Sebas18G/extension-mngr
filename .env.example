# Copia este archivo como .env en la raíz del workspace y rellena los valores.
# .env está en .gitignore: nunca se commitea ni entra en el .vsix.

# Cadena de conexión a Postgres. Si la contraseña tiene caracteres especiales (@ # / :), escápalos (@ → %40).
POSTGRES_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/postgres

# API key del endpoint compatible con OpenAI (se envía como Authorization: Bearer).
LLM_API_KEY=
